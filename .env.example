# ── Required ──────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
DOM_MASTER_SECRET=your_master_secret_here

# ── Email (optional) ─────────────────────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_IMAP_SERVER=imap.gmail.com

# ── Turso/libsql (optional, enables cloud DB sync) ───────────────────
# Leave empty for local-only mode (fully offline functional)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Database path override (optional) ────────────────────────────────
# DOM_DB_PATH=/custom/path/to/dom.db
