#!/usr/bin/env python3
"""Dom Interface — Terminal Client v4.0 (Modular Plugin Architecture)

Auto-detects cloud server or local survival mode.
Connects to cloud when available, falls back to local.

Usage:
    python3 dom              # Interactive mode
    python3 dom "message"    # Single message
    python3 dom --local      # Force local mode
    python3 dom --status     # Show connection status
"""

import sys
import os
import json
import ssl
import shlex
import subprocess
import urllib.request
from datetime import datetime

# ── Shared utilities (colors, logging, spinner, box) ─────────────────────────
from modules.util import (
    GREEN, CYAN, YELLOW, RED, BLUE, DIM, RESET, BOLD,
    SCRIPT_DIR, log_info, log_ok, log_warn, log_err,
    run_cmd, run_with_spinner, print_box,
)

# ── Dynamic plugin system ───────────────────────────────────────────────────
from modules import load_modules
from modules.system_info import (
    gather_system_metrics, is_hw_query, inject_system_context,
)

# ── Constants ────────────────────────────────────────────────────────────────

CLOUD_URL = "https://dom-interface.onrender.com"
LOCAL_URL = "http://localhost:7860"
SPEAK_ENABLED = True

# Loaded modules (populated at startup)
MODULES = []


def load_env():
    """Load .env file from SCRIPT_DIR into os.environ (won't overwrite existing vars)."""
    env_path = os.path.join(SCRIPT_DIR, ".env")
    if not os.path.isfile(env_path):
        return
    with open(env_path, "r") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                continue
            key, _, value = line.partition("=")
            key = key.strip()
            value = value.strip()
            if key and key not in os.environ:
                os.environ[key] = value


load_env()


# ── Text-to-Speech (piper-tts + sox + mpv) ──────────────────────────────────

VOX_MODEL = os.path.expanduser("~/.local/share/piper-voices/danny.onnx")

def speak(text):
    """Speak text aloud using piper-tts → sox voice FX → mpv playback."""
    global SPEAK_ENABLED
    if not text or not text.strip():
        return
    clean = text.replace("*", "").replace("`", "").replace("#", "").strip()
    clean = " ".join(clean.split())
    if not clean:
        return
    safe_text = shlex.quote(clean)
    cmd = (
        f'echo {safe_text} '
        f'| piper-tts --model {shlex.quote(VOX_MODEL)} --output_file - '
        f'| sox -t raw -r 16000 -e signed-integer -b 16 -c 1 - -t wav - '
        f'gain -n -1 treble +2 '
        f'chorus 0.5 0.7 30 0.3 0.2 2 '
        f'| mpv --no-terminal -'
    )
    try:
        subprocess.run(cmd, shell=True, timeout=30,
                       stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        log_warn("TTS playback timed out.")
    except Exception as e:
        log_err(f"TTS error: {e}")


# ── Network Checks ───────────────────────────────────────────────────────────

def check_cloud():
    try:
        ctx = ssl._create_unverified_context()
        req = urllib.request.Request(
            "https://dom-interface.onrender.com/ping",
            headers={"User-Agent": "Mozilla/5.0"}
        )
        res = urllib.request.urlopen(req, timeout=10, context=ctx)
        return res.status == 200
    except Exception:
        return False


def check_local():
    try:
        req = urllib.request.Request("http://localhost:7860/", method="GET")
        urllib.request.urlopen(req, timeout=2)
        return True
    except Exception:
        return False


# ── Send Functions ───────────────────────────────────────────────────────────

def send_cloud(message):
    try:
        ctx = ssl._create_unverified_context()
        url = "https://dom-interface.onrender.com/chat"
        data = json.dumps({"message": message}).encode("utf-8")
        headers = {
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:120.0) Gecko/20100101 Firefox/120.0",
            "Accept": "application/json, text/plain, */*",
            "Accept-Language": "en-US,en;q=0.5",
            "Content-Type": "application/json",
            "Origin": "https://dom-interface.onrender.com",
            "Referer": "https://dom-interface.onrender.com/",
        }
        req = urllib.request.Request(url, data=data, headers=headers, method="POST")
        with urllib.request.urlopen(req, timeout=30, context=ctx) as response:
            res = json.loads(response.read().decode("utf-8"))
            return res.get("reply") or res.get("response") or ""
    except Exception as e:
        log_err(f"Cloud request failed: {e}")
        return None


def send_local(message):
    body = json.dumps({"message": message}).encode("utf-8")
    req = urllib.request.Request(LOCAL_URL, data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode()).get("reply", "")


def send_survival(message):
    try:
        url = "http://localhost:11434/api/generate"
        payload = json.dumps({
            "model": "qwen2.5:0.5b",
            "prompt": message,
            "system": "You are Dom in offline survival mode. Provide concise, direct, practical, and fast answers.",
            "stream": False,
            "options": {"num_predict": 128, "temperature": 0.3}
        }).encode("utf-8")
        req = urllib.request.Request(
            url, data=payload,
            headers={"Content-Type": "application/json"},
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            res = json.loads(resp.read().decode("utf-8"))
            return res.get("response", "")
    except Exception:
        return "[SURVIVAL ERROR] Local SLM offline. Run 'sudo systemctl start ollama'"


# ── Mode Detection ───────────────────────────────────────────────────────────

def detect_mode(force_local=False):
    if force_local:
        return "local" if check_local() else "survival"
    if check_cloud():
        return "cloud"
    if check_local():
        return "local"
    return "survival"


# ── Module Trigger Matching ──────────────────────────────────────────────────

def match_module(user_input):
    """Check user input against all module triggers. Return (name, module) or None.

    Prefers the longest matching trigger so specific phrases route correctly:
    "system health" → resource_guard, never hijacked by the generic "system"
    trigger of system_info.
    """
    lower = user_input.lower()
    best = None
    best_len = -1
    for name, mod in MODULES:
        for trigger in mod.TRIGGERS:
            if trigger in lower and len(trigger) > best_len:
                best = (name, mod)
                best_len = len(trigger)
    return best


# ── Interactive Mode ─────────────────────────────────────────────────────────

def interactive_mode(force_local=False):
    global SPEAK_ENABLED
    global MODULES

    # Load all plugin modules
    MODULES = load_modules()
    if MODULES:
        loaded = ", ".join(name for name, _ in MODULES)
        log_info(f"Loaded modules: {loaded}")

    log_info("Probing connection...")
    mode = run_with_spinner("Connecting to Dom Cloud", detect_mode, force_local)

    if mode == "cloud":
        log_ok("Cloud server reachable.")
        print(f"\n  {BOLD}{CYAN}═══ Dom Interface Terminal v4.0 (CLOUD) ═══{RESET}\n")
    elif mode == "local":
        log_ok("Local C++ server detected.")
        print(f"\n  {BOLD}{CYAN}═══ Dom Interface Terminal v4.0 (LOCAL) ═══{RESET}\n")
    else:
        log_warn("Cloud unreachable — falling back to local SLM.")
        print(f"\n  {BOLD}{YELLOW}═══ Dom Interface Terminal v4.0 (SURVIVAL: qwen2.5:0.5b) ═══{RESET}")
        print(f"  {YELLOW}Run 'sudo systemctl start ollama' to enable local inference.{RESET}\n")

    print(f"  {DIM}Commands:  /online  /offline  /status  /hw  /speak  /mute  exit{RESET}\n")

    while True:
        try:
            user_input = input(f"  {BOLD}You ▸{RESET} ").strip()
            if not user_input:
                continue
            if user_input.lower() in ["exit", "quit"]:
                log_info("Disconnecting...")
                break

            # ── Built-in slash commands ─────────────────────────────────────
            if user_input.lower() == "/offline":
                mode = "survival"
                print(f"\n  {BOLD}{YELLOW}═══ Switched to Survival Mode (qwen2.5:0.5b) ═══{RESET}\n")
                continue
            elif user_input.lower() == "/online":
                log_info("Checking cloud connectivity...")
                if run_with_spinner("Pinging cloud", check_cloud):
                    mode = "cloud"
                    log_ok("Cloud online.")
                    print(f"\n  {BOLD}{CYAN}═══ Switched to Cloud Mode ═══{RESET}\n")
                else:
                    log_warn(f"Cloud unreachable. Staying in {mode.upper()} mode.\n")
                continue
            elif user_input.lower() == "/status":
                c = check_cloud()
                l = check_local()
                voice = "ON  ✓" if SPEAK_ENABLED else "OFF ✗"
                body = f"Cloud:  {'ONLINE  ✓' if c else 'OFFLINE ✗'}\nLocal:  {'ONLINE  ✓' if l else 'OFFLINE ✗'}\nMode:   {mode.upper()}\nVoice:  {voice}"
                print_box("System Status", body, CYAN)
                continue
            elif user_input.lower() == "/speak":
                SPEAK_ENABLED = True
                log_ok("Voice output enabled.")
                continue
            elif user_input.lower() == "/mute":
                SPEAK_ENABLED = False
                log_ok("Voice output muted.")
                continue

            # ── Dynamic module matching ─────────────────────────────────────
            match = match_module(user_input)
            if match:
                mod_name, mod = match
                try:
                    result = mod.execute(user_input)
                except Exception as e:
                    log_err(f"Module [{mod_name}] crashed: {e}")
                    continue

                if result is None:
                    pass  # pass-through to LLM
                else:
                    output = result.get("output", "")
                    if result.get("status") == "error":
                        log_err(f"Module [{mod_name}] failed: {output}")
                    elif output:
                        print_box(mod_name.replace("_", " ").title(), output, CYAN)
                        if SPEAK_ENABLED:
                            speak_text = output if len(output) <= 200 else output[:200].rsplit(".", 1)[0].rsplit("\n", 1)[-1].strip() + "."
                            run_with_spinner("Speaking", speak, speak_text)
                    continue

            # ── LLM query (cloud / local / survival) ───────────────────────
            # Inject real system context for hardware-related queries
            outgoing = inject_system_context(user_input) if (mode in ("cloud", "local") and is_hw_query(user_input)) else user_input

            label = {"cloud": "Cloud", "local": "Local", "survival": "SLM (qwen2.5:0.5b)"}[mode]
            reply = run_with_spinner(f"Querying {label}", {
                "cloud": send_cloud,
                "local": send_local,
                "survival": send_survival
            }[mode], outgoing)

            if reply is None:
                log_err("No response received.")
                if mode == "cloud":
                    log_warn("Falling back to survival mode...")
                    mode = "survival"
                    reply = run_with_spinner("Querying SLM", send_survival, user_input)
                if not reply:
                    continue

            # Format response
            if reply.startswith("[SURVIVAL ERROR]") or reply.startswith("[DEBUG"):
                print(f"\n  {RED}⚠{RESET}  {reply}\n")
            else:
                print(f"\n  {GREEN}Dom ▸{RESET} {reply}\n")
                if SPEAK_ENABLED:
                    run_with_spinner("Speaking", speak, reply)

        except (KeyboardInterrupt, EOFError):
            print()
            log_info("Disconnected.")
            break
        except Exception as e:
            log_err(f"Connection error: {e}")


# ── Main Entry ───────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) > 1:
        if sys.argv[1] == "--status":
            cloud = check_cloud()
            local = check_local()
            body = f"Cloud:  {'ONLINE  ✓' if cloud else 'OFFLINE ✗'}\nLocal:  {'ONLINE  ✓' if local else 'OFFLINE ✗'}"
            print_box("System Status", body, CYAN)
            return
        elif sys.argv[1] == "--local":
            interactive_mode(force_local=True)
            return
        else:
            message = " ".join(sys.argv[1:])
            mode = run_with_spinner("Probing connection", detect_mode)

            # Check if a module handles this message
            match = match_module(message)
            if match:
                mod_name, mod = match
                try:
                    result = mod.execute(message)
                except Exception as e:
                    log_err(f"Module [{mod_name}] crashed: {e}")
                    return

                if result is None:
                    pass  # pass-through to LLM
                else:
                    output = result.get("output", "")
                    if result.get("status") == "error":
                        log_err(f"Module [{mod_name}] failed: {output}")
                    elif output:
                        print_box(mod_name.replace("_", " ").title(), output, CYAN)
                    return

            # Inject real system context for hardware queries
            outgoing = inject_system_context(message) if mode in ("cloud", "local") and is_hw_query(message) else message

            try:
                sender = {"cloud": send_cloud, "local": send_local, "survival": send_survival}[mode]
                reply = run_with_spinner(f"Querying {mode}", sender, outgoing)
                if reply:
                    print(reply)
                elif mode == "cloud":
                    log_warn("Cloud failed, falling back to survival...")
                    reply = run_with_spinner("Querying SLM", send_survival, message)
                    if reply:
                        print(reply)
            except Exception as e:
                log_err(f"Error: {e}")
            return

    interactive_mode()


if __name__ == "__main__":
    main()
