#!/usr/bin/env python3
"""Dom Interface — Terminal Client v3.0

Auto-detects cloud server or local survival mode.
Connects to cloud when available, falls back to local.

Usage:
    python3 dom              # Interactive mode
    python3 dom "message"    # Single message
    python3 dom --local      # Force local mode
    python3 dom --status     # Show connection status
"""

import sys
import os
import json
import threading
import time

# ANSI Colors
GREEN = "\033[92m"
CYAN = "\033[96m"
YELLOW = "\033[93m"
RED = "\033[91m"
RESET = "\033[0m"
BOLD = "\033[1m"

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
CLOUD_URL = "https://dom-interface.onrender.com/chat"
LOCAL_URL = "http://localhost:10000/chat"


def show_spinner(stop_event, message="Syncing with Dom"):
    """Runs an animated spinner in a background thread."""
    spinner_chars = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    i = 0
    while not stop_event.is_set():
        sys.stdout.write(f"\r{GREEN}{spinner_chars[i % len(spinner_chars)]}{RESET} {message}...")
        sys.stdout.flush()
        time.sleep(0.08)
        i += 1
    sys.stdout.write("\r\033[K")
    sys.stdout.flush()


def check_cloud():
    """Check if cloud server is reachable."""
    try:
        import urllib.request
        req = urllib.request.Request("https://dom-interface.onrender.com/", method="GET")
        urllib.request.urlopen(req, timeout=5)
        return True
    except Exception:
        return False


def check_local():
    """Check if local server is running."""
    try:
        import urllib.request
        req = urllib.request.Request("http://localhost:10000/", method="GET")
        urllib.request.urlopen(req, timeout=2)
        return True
    except Exception:
        return False


def send_cloud(message):
    """Send message to cloud server."""
    import urllib.request
    body = json.dumps({"message": message}).encode("utf-8")
    req = urllib.request.Request(CLOUD_URL, data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode()).get("reply", "No response.")


def send_local(message):
    """Send message to local server."""
    import urllib.request
    body = json.dumps({"message": message}).encode("utf-8")
    req = urllib.request.Request(LOCAL_URL, data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode()).get("reply", "No response.")


def send_survival(message):
    """Run survival engine directly (no server needed)."""
    sys.path.insert(0, os.path.join(SCRIPT_DIR, "dom_survival"))
    from core.tags import TagRegistry, clean_output
    from core.engine import infer
    from core.memory import update_ram

    tags = TagRegistry()
    # Load plugins
    for mod_name in ["plugins.system", "plugins.files", "plugins.search", "plugins.notifications"]:
        try:
            import importlib
            mod = importlib.import_module(mod_name)
            if hasattr(mod, "register"):
                mod.register(tags)
        except Exception:
            pass

    update_ram("user", message)
    reply = infer(message)
    tag_results = tags.process_all(reply)
    if tag_results and "[RECALLED" not in tag_results:
        pass  # Simplified for client
    update_ram("assistant", reply)
    return clean_output(reply)


def detect_mode(force_local=False):
    """Detect best available mode."""
    if force_local:
        if check_local():
            return "local"
        return "survival"
    if check_cloud():
        return "cloud"
    if check_local():
        return "local"
    return "survival"


def run_email_plugin():
    """Run email cleanup plugin."""
    script = os.path.join(SCRIPT_DIR, "dom_cloud", "plugins", "emails.py")
    if os.path.exists(script):
        print(f"\n{YELLOW}[SYSTEM] Launching email engine...{RESET}")
        os.system(f"python3 -u {script}")
    else:
        print(f"{RED}[Error]: Email plugin not found at {script}{RESET}")


def run_maintenance_plugin():
    """Run system maintenance plugin."""
    script = os.path.join(SCRIPT_DIR, "dom_cloud", "plugins", "maintain.py")
    if os.path.exists(script):
        print(f"\n{YELLOW}[SYSTEM] Initiating maintenance...{RESET}")
        os.system(f"python3 -u {script}")
    else:
        print(f"{RED}[Error]: Maintenance plugin not found at {script}{RESET}")


def interactive_mode(force_local=False):
    """Run Dom in interactive mode."""
    mode = detect_mode(force_local)
    print(f"\n{BOLD}{CYAN}=== Dom Interface Terminal v3.0 ({mode.upper()}) ==={RESET}")
    print(f"Type 'exit' to close.\n")

    while True:
        try:
            user_input = input(f"{BOLD}You:{RESET} ").strip()
            if not user_input:
                continue
            if user_input.lower() in ["exit", "quit"]:
                print("Disconnecting...")
                break

            # Detect special local commands
            if any(w in user_input.lower() for w in ["email", "emails", "inbox", "mail"]):
                run_email_plugin()
            elif any(w in user_input.lower() for w in ["system", "maintenance", "optimize", "clean system"]):
                run_maintenance_plugin()

            # Send to active mode
            stop_spinner = threading.Event()
            spinner_thread = threading.Thread(target=show_spinner, args=(stop_spinner,))
            spinner_thread.start()

            try:
                if mode == "cloud":
                    reply = send_cloud(user_input)
                elif mode == "local":
                    reply = send_local(user_input)
                else:
                    reply = send_survival(user_input)

                stop_spinner.set()
                spinner_thread.join()
                print(f"{BOLD}{GREEN}Dom Interface:{RESET} {reply}\n")

            except Exception as e:
                stop_spinner.set()
                spinner_thread.join()
                # Try fallback modes
                if mode == "cloud":
                    print(f"{YELLOW}Cloud unreachable, trying local...{RESET}")
                    try:
                        reply = send_survival(user_input)
                        print(f"{BOLD}{GREEN}Dom Interface:{RESET} {reply}\n")
                    except Exception as e2:
                        print(f"{RED}[Error]: {e2}{RESET}\n")
                else:
                    print(f"{RED}[Error]: {e}{RESET}\n")

        except (KeyboardInterrupt, EOFError):
            print(f"\n{YELLOW}Disconnected.{RESET}")
            break
        except Exception as e:
            print(f"\n{RED}[Connection Error]: {e}{RESET}\n")


def main():
    if len(sys.argv) > 1:
        if sys.argv[1] == "--status":
            cloud = check_cloud()
            local = check_local()
            print(f"Cloud: {'ONLINE' if cloud else 'OFFLINE'}")
            print(f"Local: {'ONLINE' if local else 'OFFLINE'}")
            return
        elif sys.argv[1] == "--local":
            interactive_mode(force_local=True)
            return
        else:
            # Single message mode
            message = " ".join(sys.argv[1:])
            mode = detect_mode()
            try:
                if mode == "cloud":
                    print(send_cloud(message))
                elif mode == "local":
                    print(send_local(message))
                else:
                    print(send_survival(message))
            except Exception as e:
                print(f"Error: {e}")
            return

    interactive_mode()


if __name__ == "__main__":
    main()
